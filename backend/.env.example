# Existing backend/.env is private: do not overwrite it when updating.
# URL-encode credentials in DATABASE_URL. Docker uses separate POSTGRES_* variables.
DATABASE_URL=postgresql+asyncpg://<user>:<password>@localhost:5432/<database>
CORS_ORIGINS=http://localhost:3000
APP_ORIGIN=http://localhost:3000
PUBLIC_API_URL=http://localhost:8000
SESSION_HOURS=8
RESERVATION_MINUTES=15
ENABLE_EMAIL_VERIFICATION=false

# Blank SMTP_HOST writes private local messages to backend/.mailbox.
SMTP_HOST=
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=false
EMAIL_FROM="Paper & Petal <hello@paperandpetal.local>"
# Optional MAIL_DIR / UPLOAD_DIR override backend/.mailbox and backend/media.

# Configure official sandbox merchant credentials before enabling online checkout.
PAYMENT_ENVIRONMENT=sandbox
ESEWA_PRODUCT_CODE=
ESEWA_SECRET_KEY=
KHALTI_SECRET_KEY=
